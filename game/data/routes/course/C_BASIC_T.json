  "tutorial_steps": [
    {"step_id": "T01-A", "text_ko": "왼손을 끌어 표시된 왼쪽 위 홀드에 놓아 보세요.", "goal_event": {"type": "grab", "limb": "LH", "slot": "C_BASIC_T/H03/hand_1"}, "help_ko": ["왼손을 움직여요.", "왼손을 표시된 왼쪽 위 홀드까지 끌어서 놓아요."], "rules": {"fatigue_drain": false, "techniques": []}},
    {"step_id": "T01-B", "text_ko": "이번엔 오른손으로 표시된 오른쪽 위 홀드를 잡아 보세요.", "goal_event": {"type": "grab", "limb": "RH", "slot": "C_BASIC_T/H04/hand_1"}, "help_ko": ["오른손을 움직여요.", "오른손을 표시된 오른쪽 위 홀드까지 끌어서 놓아요."], "rules": {"fatigue_drain": false, "techniques": []}},
    {"step_id": "T01-C", "text_ko": "손가락을 떼어도 계속 잡고 있으니 1초 동안 모든 패드에서 손가락을 떼 보세요.", "goal_event": {"type": "hold_still", "seconds": 1.0}, "help_ko": ["아무 팔다리도 움직이지 않아요.", "모든 패드에서 손가락을 떼고 1초 기다려요."], "rules": {"fatigue_drain": false, "techniques": []}},
    {"step_id": "T02-A", "text_ko": "왼발을 끌어 표시된 높은 왼쪽 발판에 디뎌 보세요.", "goal_event": {"type": "grab", "limb": "LF", "slot": "C_BASIC_T/F03/foot_1"}, "help_ko": ["왼발을 움직여요.", "왼발을 표시된 왼쪽 발판까지 끌어서 놓아요."], "rules": {"fatigue_drain": false, "techniques": []}},
    {"step_id": "T02-B", "text_ko": "오른발도 맞은편 발판에 디디면 두 발로 체중을 받치며 몸이 일어서요.", "goal_event": {"type": "grab", "limb": "RF", "slot": "C_BASIC_T/F04/foot_1"}, "help_ko": ["오른발을 움직여요.", "오른발을 표시된 오른쪽 발판까지 끌어서 놓아요."], "rules": {"fatigue_drain": false, "techniques": []}},
    {"step_id": "T02-D", "text_ko": "두 발로 버티며 가만히 쉬어 지친 팔의 힘을 되찾아 보세요.", "goal_event": {"type": "hold_still", "seconds": 2.0}, "help_ko": ["아무 팔다리도 움직이지 않아요.", "두 발을 발판에 둔 채 2초 동안 손가락을 떼고 쉬어요."], "rules": {"fatigue_drain": false, "techniques": [], "start_stamina": 70}},
    {"step_id": "T02-E", "text_ko": "몸이 올라와 닿게 된 왼쪽 위 홀드를 왼손으로 잡아 보세요.", "goal_event": {"type": "grab", "limb": "LH", "slot": "C_BASIC_T/H05/hand_1"}, "help_ko": ["왼손을 움직여요.", "왼손을 표시된 왼쪽 위 홀드까지 끌어서 놓아요."], "rules": {"fatigue_drain": false, "techniques": []}},
    {"step_id": "T03-A", "text_ko": "오른손과 왼발은 잡아 둔 채 왼손과 오른발을 함께 끌어 옮겨 보세요.", "goal_event": {"type": "together", "limbs": ["LH", "RF"], "ticks": 6}, "help_ko": ["왼손과 오른발을 동시에 움직여요.", "왼손은 왼쪽 위 홀드로, 오른발은 오른쪽 위 발판으로 함께 끌고 2초 안에 둘 다 놓아요."], "rules": {"fatigue_drain": false, "techniques": [], "start_stamina": 100}},
    {"step_id": "T03-B", "text_ko": "이번엔 반대로 오른손과 왼발을 함께 끌어 옮겨 보세요.", "goal_event": {"type": "together", "limbs": ["RH", "LF"], "ticks": 6}, "help_ko": ["오른손과 왼발을 동시에 움직여요.", "오른손은 오른쪽 위 홀드로, 왼발은 왼쪽 위 발판으로 함께 끌고 2초 안에 둘 다 놓아요."], "rules": {"fatigue_drain": false, "techniques": []}},
    {"step_id": "T03-C", "text_ko": "두 손을 모두 떼면 지지를 잃고 떨어지는지 직접 확인해 보세요.", "goal_event": {"type": "fall"}, "help_ko": ["두 손을 움직여요.", "왼손과 오른손을 홀드에서 떼고 기다려요."], "rules": {"fatigue_drain": false, "techniques": []}},
    {"step_id": "T03-D", "text_ko": "이제 손이 지치니 두 발을 올려 받치며 표시된 왼쪽 위 홀드까지 올라가 보세요.", "start_pose": {"pelvis": [-0.24, 1.88], "angle": 0.0, "slots": {"LH": "C_BASIC_T/H06/hand_1", "RH": "C_BASIC_T/H07/hand_1", "LF": "C_BASIC_T/F06/foot_1", "RF": "C_BASIC_T/F05/foot_1"}}, "goal_event": {"type": "grab", "limb": "LH", "slot": "C_BASIC_T/H08/hand_1"}, "help_ko": ["왼발과 오른발을 먼저, 그다음 왼손을 움직여요.", "두 발을 바로 위 발판에 올린 뒤 왼손으로 표시된 왼쪽 위 홀드를 잡아요."], "rules": {"fatigue_drain": true, "start_stamina": 100, "techniques": []}},
    {"step_id": "T03-E", "text_ko": "맨 위 두 정상 홀드를 양손으로 잡고 버티면 완등이에요.", "goal_event": {"type": "clear"}, "help_ko": ["오른손과 왼손을 움직여요.", "두 손을 맨 위 정상 홀드 두 개에 하나씩 놓고 버텨요."], "rules": {"fatigue_drain": true, "techniques": []}}
  ]
