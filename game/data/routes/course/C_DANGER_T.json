    {"step_id": "D5", "only_level": "beginner", "text_ko": "한 번 더 해 봐요. 붉게 뛰면 바로 고리를 눌러요.", "goal_event": {"type": "rescue"}, "start_pose": {"pelvis": [-0.353, 1.156], "angle": 0.84, "slots": {"LF": "C_DANGER_T/F03/foot_1", "RF": "C_DANGER_T/F04/foot_1"}}, "help_ko": ["캐릭터 둘레 고리 안을 눌러요", "패드로 다시 잡으면 이 단계를 다시 해요"], "rules": {"fatigue_drain": false, "techniques": [], "rescue": true, "danger_seconds": 4}}
